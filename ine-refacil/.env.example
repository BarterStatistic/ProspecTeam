# Plantilla. Copia este archivo como .env y llena los valores.
# El .env real está en .gitignore y nunca se sube al repo.

# Solo la necesita la app suelta de static/ (su propio OCR). Marga lee la INE
# por su cuenta con VITE_GEMINI_API_KEY; si únicamente usas Marga, déjala vacía.
# Se saca gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Formulario que se va a llenar.
REFACIL_FORM_URL=https://www.refacil.com.mx/formularioDinamo.php?id=33628&intranet=0

# Segundos de espera entre campo y campo. Súbelo para ver el llenado más lento,
# bájalo a 0 para que termine cuanto antes.
PAUSA_ENTRE_CAMPOS=0.4

# Orígenes de Marga que pueden pedirle un llenado a este servicio, separados por
# coma. El default ya cubre `npm run dev` (5174) y `npm run preview` (4173);
# agrega aquí el dominio de la Marga publicada cuando la subas.
# MARGA_ORIGENES=http://localhost:5174,https://marga-6bb72.web.app
