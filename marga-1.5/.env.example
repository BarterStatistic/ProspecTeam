# Marga 1.5 — configuración de Firebase
# Copia este archivo como `.env.local` y pega los valores de tu proyecto:
# Firebase console → Configuración del proyecto → Tus apps → App web → Config.
# `.env.local` está ignorado por git: NUNCA subas estas llaves al repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo demostración (sin Firebase): pon VITE_DEMO=1 para usar una base local
# en este navegador (los datos NO se comparten entre dispositivos).
# VITE_DEMO=1

# ---------------------------------------------------------------------------
# Herramientas → Buró Automático
# ---------------------------------------------------------------------------

# Lectura de la INE con Gemini 2.5 Flash. Se saca gratis en
# https://aistudio.google.com/apikey
#
# ATENCIÓN: Vite mete esta llave en el bundle, así que queda a la vista de
# cualquiera que abra la app. Antes de publicar, restringe la llave en Google
# Cloud → Credenciales:
#   - Restricción de aplicación: sitios web (referrer HTTP) → tu dominio.
#   - Restricción de API: solo Generative Language API.
#   - Cuota diaria baja, para que un abuso no se convierta en una factura.
# Sin la llave el resto de Marga funciona igual; solo el OCR queda inhabilitado.
VITE_GEMINI_API_KEY=

# Servicio local que llena el formulario de Refácil con Selenium
# (`python ine-refacil/app.py`). Solo hace falta cambiarlo si lo corres en otro
# puerto o en otra máquina de la red.
# VITE_BURO_SERVICIO_URL=http://localhost:5000
