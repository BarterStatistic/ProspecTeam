# Marga 1.5 — configuración de Firebase
# Copia este archivo como `.env.local` y pega los valores de tu proyecto:
# Firebase console → Configuración del proyecto → Tus apps → App web → Config.
# `.env.local` está ignorado por git: NUNCA subas estas llaves al repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo demostración (sin Firebase): pon VITE_DEMO=1 para usar una base local
# en este navegador (los datos NO se comparten entre dispositivos).
# VITE_DEMO=1
